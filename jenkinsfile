pipeline {
    agent any
    
    tools {
        maven 'maven3'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub_cred')
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'jenkins',
                    url: 'https://github.com/nikitaks97/maven-employee-web-application.git'
            }
        }
        stage('Maven Build') {
            steps {
                sh 'mvn clean install -DskipTests --no-transfer-progress  -Denforcer.skip=true'
            }
        }
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t jenkinssvc .'
            }
        }
        stage('Push Docker Image') {
            steps {
                sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
                sh 'docker push nikitaks97/jenkinssvc'                    

            }
        }
        
    }
}
