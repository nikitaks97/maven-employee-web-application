pipeline {
    agent any
    
    tools {
        maven 'maven3'
        git 'Git'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub_cred')
    }
    stages {
        stage('Clean up git lock files') {
        steps {
        sh 'rm -f /var/jenkins_home/caches/git-*/.git/config.lock || true'
            }
       }

        stage('Checkout') {
            steps {
                git branch: 'jenkins',
                    url: 'https://github.com/nikitaks97/maven-employee-web-application.git'
                    credentialsId: "${DOCKERHUB_CREDENTIALS}"
            }
        }
        stage('Maven Build') {
            steps {
                sh 'mvn clean install -DskipTests --no-transfer-progress -Denforcer.skip=true'
            }
        }
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t jenkinssvc .'
            }
        }
        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub_cred', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin'
                    sh 'docker tag jenkinssvc nikitaks97/jenkinssvc:latest'
                    sh 'docker push nikitaks97/jenkinssvc:latest'
                }
            }
        }
    }
}
